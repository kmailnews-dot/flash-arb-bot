# Copy this file to .env for local runs, or set the same names as GitHub Actions
# repository secrets (Settings -> Secrets and variables -> Actions -> Secrets, not Variables)
# for the scheduled bot. See the README for the full walkthrough, including where to find each address.

# --- RPC endpoint ---
# A free tier from Alchemy, Infura, or a public Arbitrum RPC all work.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# --- Fork integration test (npm run test:fork) ---
# Pin the Arbitrum block used by test/ForkArbitrum.test.js. The test is skipped when this is unset.
# Forking an old block usually requires an archive-capable RPC; ARBITRUM_RPC_URL is used by default.
# ARBITRUM_FORK_BLOCK=
# ARBITRUM_FORK_RPC_URL=

# --- Safety switch ---
# true  (default): scan and log opportunities only, never send a transaction. Costs $0, no wallet needed.
# false: also submit the flash-loan transaction on-chain. Requires PRIVATE_KEY, CONTRACT_ADDRESS,
#        and a wallet funded with a small amount of ETH to pay gas (the flash loan principal is
#        still $0 - only the gas for submitting the transaction is a real cost you must fund).
DRY_RUN=true
# --- Only needed once DRY_RUN=false ---
# Private key of a wallet holding a small ETH balance for gas. Never commit this. In GitHub
# Actions, store it as a repo secret, never in code.
PRIVATE_KEY=
# Address of your deployed FlashArbExecutor contract (see `npm run deploy`).
CONTRACT_ADDRESS=0x0577BcAac24e97684D12D01610071Ac1579F9b99

# --- Aave V3 ---
# Look up the current PoolAddressesProvider for Arbitrum at
# https://aave.com/docs/resources/addresses before deploying -
# addresses can change between Aave versions/markets, so don't assume an old value is still right.
AAVE_POOL_ADDRESSES_PROVIDER=0xa97684ead0e402dC232d5A977953DF7ECBaB3CDb
# Aave V3's default flash loan fee is 0.05% (5 bps); confirm on the same docs page above.
AAVE_FLASH_LOAN_PREMIUM_BPS=5

# --- Profitability filters ---
MIN_PROFIT_USD=5
MIN_PROFIT_BUFFER_BPS=5000
SLIPPAGE_BPS=50
# Used by the scanner to price gas in USD before deciding whether a trade is worth it.
GAS_LIMIT_ESTIMATE=700000
# Hard cap for live submissions: the bot simulates the call and estimates its gas first, and
# skips the trade if the estimate exceeds this value.
MAX_GAS_LIMIT=1000000
GAS_PRICE_BUFFER_PCT=20

# --- Live execution loss guards (only used when DRY_RUN=false) ---
# Refuse to trade on any chain other than this one. 42161 = Arbitrum One, 421614 = Arbitrum Sepolia.
EXPECTED_CHAIN_ID=42161
# Refuse to submit if the burner wallet holds more than this much ETH (limits blast radius).
MAX_WALLET_BALANCE_ETH=0.1
# Daily cumulative gas cap, persisted across runs and reset at UTC midnight.
MAX_DAILY_GAS_ETH=0.01
# Open the circuit breaker after this many consecutive failed execution attempts, and keep it
# closed for CIRCUIT_BREAKER_COOLDOWN_MINUTES before allowing another attempt.
MAX_CONSECUTIVE_FAILURES=5
CIRCUIT_BREAKER_COOLDOWN_MINUTES=60
# Optional state-file overrides (defaults shown). Keep these out of Git; ./logs/ is ignored.
# GAS_SPENT_PATH=./logs/gas_spent.json
# CIRCUIT_BREAKER_PATH=./logs/circuit_breaker.json

# --- Scan persistence ---
# Append-only JSONL: one line per trade size per scan. Keep this file across runs to measure
# opportunities over days/weeks. Parent directories are created automatically.
SCAN_LOG_PATH=./logs/scans.jsonl

# --- Live USD reference price (optional but recommended) ---
# Lets the bot price gas and profit in USD by quoting 1 WETH -> a stablecoin on a real DEX pool,
# with no external price API/key needed. Leave unset to disable USD filtering (the bot then only
# checks that the raw on-chain profit is positive).
#
# ETH_USD_ROUTE_JSON=

# --- Pairs to scan ---
# A JSON array. Each entry describes one borrow-token/intermediate-token round trip across two
# DEX routers ("legOut": borrowed -> intermediate, "legBack": intermediate -> borrowed).
# `kind` is "V2" (Uniswap V2-style router: SushiSwap, Camelot V2, ...) or "V3" (Uniswap V3).
# A V3 leg needs a numeric `v3Fee` pool tier (e.g. 500/3000/10000) and BOTH `router` (the
# ORIGINAL Uniswap V3 SwapRouter, whose ExactInputSingleParams includes `deadline`) and `quoter`
# (the separate QuoterV2 address used only for off-chain price-checking - the SwapRouter itself
# doesn't expose a quote function).
# SwapRouter02 is INCOMPATIBLE with ISwapRouterV3Like.sol: its ExactInputSingleParams has no
# `deadline` field (SwapRouter02 uses multicall(deadline, ...) instead), so the function selector
# differs and the call reverts.
# For Arbitrum One, the original SwapRouter is
# 0xE592427A0AEce92De3Edee1F18E0157C05861564 (official Uniswap deployment list). Do NOT use
# SwapRouter02 0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45 with this interface.
# `isStable`/`isWeth` on borrowedToken tell the bot how to convert profit into USD - see README.
#
# PAIRS_CONFIG_JSON=
#   {
#     "label": "WETH/USDC via SushiSwap + Uniswap V3",
#     "borrowedToken": { "address": "<WETH>", "decimals": 18, "symbol": "WETH", "isWeth": true },
#     "intermediateToken": { "address": "<USDC>", "decimals": 6, "symbol": "USDC" },
#     "legOut":  { "kind": "V2", "router": "<SushiSwap V2 router>", "tokenOut": "<USDC>" },
#     "legBack": { "kind": "V3", "router": "<Uniswap V3 SwapRouter (original)>", "quoter": "<Uniswap V3 QuoterV2>", "tokenOut": "<WETH>", "v3Fee": 500 },
#     "tradeSizes": ["1", "5", "20"]
#   }
# ]'
PAIRS_CONFIG_JSON=
